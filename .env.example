# Copy to .env.local and fill in. Never commit real secrets.

# ── Supabase (required) — Project Settings → API ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Needed for the Stripe webhook to update subscriptions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# Public URL used for SEO (sitemap, canonical, Open Graph). With or without https://
NEXT_PUBLIC_SITE_URL=https://invoice-generator1718.vercel.app
# Optional Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Business plan (optional) — Calendly/Cal.com link for onboarding calls ─────
NEXT_PUBLIC_ONBOARDING_BOOKING_URL=

# ── Payments (optional — without these, upgrades are done manually by an admin) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=

# ── Contact form (optional) — Slack/Discord/Zapier webhook receiving messages ──
CONTACT_WEBHOOK_URL=
